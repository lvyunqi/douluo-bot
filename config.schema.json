{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "斗罗大陆文字游戏",
  "description": "插件启动、内容包、管理服务、身份命名空间、插图和跨协议消息配置。",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "database": {
      "title": "数据库",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "relative_path": {
          "title": "数据库相对路径",
          "description": "相对 QimenBot data_dir 的路径，不允许绝对路径或上级目录。",
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "default": "douluo-game/douluo.db"
        },
        "busy_timeout_ms": {
          "title": "数据库等待超时",
          "description": "SQLite 被短事务占用时的最大等待时间。",
          "type": "integer",
          "minimum": 100,
          "maximum": 30000,
          "multipleOf": 100,
          "default": 3000
        }
      }
    },
    "content": {
      "title": "内容发布",
      "description": "从 QimenBot data_dir 内的 JSON/TOML 文件创建并校验内容草稿；默认不会自动发布。",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "package_file": {
          "title": "内容包相对路径",
          "description": "相对 data_dir 的 .json 或 .toml 文件；留空时不加载外部内容包。",
          "type": "string",
          "maxLength": 200,
          "pattern": "^(?:|(?!.*/(?:\\.|\\.\\.)(?:/|$))[^\\\\:]+\\.(?:json|toml))$",
          "default": ""
        },
        "auto_publish": {
          "title": "校验通过后自动发布",
          "description": "开启后在插件 reload/init 时原子发布新 revision；同键同 revision 内容变化会拒绝启动。",
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "auto_publish": { "const": true } },
            "required": ["auto_publish"]
          },
          "then": {
            "properties": { "package_file": { "minLength": 1 } },
            "required": ["package_file"]
          }
        }
      ]
    },
    "web": {
      "title": "管理服务",
      "description": "默认关闭并仅允许回环监听；启用后提供独立的游戏管理 API。",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "enabled": {
          "title": "启用管理服务",
          "type": "boolean",
          "default": false
        },
        "bind": {
          "title": "监听 IP",
          "description": "默认仅监听回环地址；不接受域名，避免 DNS 重绑定边界不清。",
          "type": "string",
          "minLength": 1,
          "maxLength": 45,
          "default": "127.0.0.1"
        },
        "port": {
          "title": "监听端口",
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 18181
        },
        "allow_remote": {
          "title": "允许非回环监听",
          "description": "仅在反向代理已提供 HTTPS 时开启；开启后必须配置公开 HTTPS 基址。",
          "type": "boolean",
          "default": false
        },
        "public_base_url": {
          "title": "公开 HTTPS 基址",
          "description": "非回环部署所用的反向代理 HTTPS 地址，不含查询参数。",
          "type": "string",
          "maxLength": 300,
          "default": ""
        },
        "admin_secret": {
          "title": "管理密钥",
          "description": "仅用于建立短期管理会话，不会显示或写入插件日志。",
          "type": "string",
          "minLength": 16,
          "maxLength": 256,
          "format": "password",
          "writeOnly": true,
          "x-qimen-secret": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enabled": { "const": true } },
            "required": ["enabled"]
          },
          "then": {
            "required": ["admin_secret"]
          }
        },
        {
          "if": {
            "properties": { "allow_remote": { "const": true } },
            "required": ["allow_remote"]
          },
          "then": {
            "properties": { "public_base_url": { "minLength": 9 } },
            "required": ["public_base_url"]
          }
        }
      ]
    },
    "identity": {
      "title": "身份",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "namespace": {
          "title": "身份命名空间",
          "description": "同一数据库部署多个机器人时用于隔离存档；投入使用后不要随意修改。",
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "default": "default"
        },
        "qq_official_account_id": {
          "title": "QQ 官方机器人账号",
          "description": "仅供不含 qimen_context 的旧版 QimenBot 单机器人部署回退使用。建议填写稳定 AppID；新版宿主提供 account_id 时两者必须完全一致。留空会对无法确认账号的有状态命令安全拒绝。",
          "type": "string",
          "maxLength": 128,
          "pattern": "^(?:|[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?)$",
          "default": ""
        },
        "max_character_name_chars": {
          "title": "角色名最大长度",
          "description": "按 Unicode 字符数量计算。",
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "default": 6
        }
      }
    },
    "authorization": {
      "title": "授权上下文",
      "description": "控制群聊和频道是否需要显式授权；私聊始终允许。",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "mode": {
          "title": "上下文策略",
          "description": "allow_all 保持兼容并允许所有群/频道；allowlist 只允许 owner 已授权的上下文。",
          "type": "string",
          "enum": ["allow_all", "allowlist"],
          "default": "allow_all"
        }
      }
    },
    "illustrations": {
      "title": "插图",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "enabled": {
          "title": "启用游戏插图",
          "description": "为地图、武魂、魂兽、NPC、物品和剧情消息附加插图；正文始终保留文本降级。",
          "type": "boolean",
          "default": true
        },
        "mode": {
          "title": "图片模式",
          "description": "direct 从 data_dir 内预加载图片并以内联方式发送；remote 使用可独立部署的斗罗图片服务。",
          "type": "string",
          "enum": ["direct", "remote"],
          "default": "direct"
        },
        "direct_asset_root": {
          "title": "本地插图根目录",
          "description": "direct 模式从 QimenBot data_dir 下此相对目录预加载图片；文件路径必须与稳定 asset_key 一致，目录不存在时纯文字降级。",
          "type": "string",
          "maxLength": 200,
          "default": "douluo-game/assets"
        },
        "remote_base_url": {
          "title": "远程图片服务地址",
          "description": "remote 模式使用的公网 HTTPS 基址，不要填写末尾 /media 路径。",
          "type": "string",
          "maxLength": 300,
          "default": ""
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "remote" } },
            "required": ["mode"]
          },
          "then": {
            "properties": {
              "remote_base_url": {
                "type": "string",
                "pattern": "^https://[^\\s?#()]+(?:/[^\\s?#()]*)?$",
                "minLength": 9
              }
            },
            "required": ["remote_base_url"]
          }
        }
      ]
    },
    "messages": {
      "title": "消息",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "qq_official_markdown": {
          "title": "QQ 官方机器人使用 Markdown",
          "type": "boolean",
          "default": true
        },
        "onebot_markdown": {
          "title": "OneBot 使用 Markdown 扩展",
          "description": "仅在 NapCat/Lagrange 等目标实现已实测支持时开启；通用 OneBot 11 默认使用文本。",
          "type": "boolean",
          "default": false
        },
        "legacy_hyphen_arguments": {
          "title": "兼容旧横线参数",
          "description": "允许“开始穿越 角色名-性别”。",
          "type": "boolean",
          "default": true
        }
      }
    }
  }
}
