{
  "": {
    "ui:order": ["database", "content", "web", "identity", "authorization", "illustrations", "messages"]
  },
  "/database": {
    "hidden": true
  },
  "/content": {
    "hidden": true
  },
  "/database/busy_timeout_ms": {
    "ui:widget": "slider",
    "unit": "毫秒",
    "step": 100
  },
  "/content/package_file": {
    "placeholder": "douluo-game/content/package.toml",
    "width": "full"
  },
  "/web/bind": {
    "placeholder": "127.0.0.1",
    "width": "half"
  },
  "/web/public_base_url": {
    "placeholder": "https://game-admin.example.com",
    "width": "full"
  },
  "/web/admin_secret": {
    "ui:widget": "password",
    "width": "full"
  },
  "/identity/max_character_name_chars": {
    "ui:widget": "slider",
    "unit": "字符",
    "step": 1
  },
  "/identity/qq_official_account_id": {
    "placeholder": "QQ 官方机器人 AppID（旧 Host 单 Bot 回退）",
    "width": "full"
  },
  "/authorization/mode": {
    "ui:widget": "badges",
    "labels": {
      "allow_all": "允许所有群/频道",
      "allowlist": "仅允许已授权上下文"
    }
  },
  "/illustrations/mode": {
    "ui:widget": "badges",
    "labels": {
      "direct": "本地内联",
      "remote": "远程图片服务"
    }
  },
  "/illustrations/direct_asset_root": {
    "placeholder": "douluo-game/assets",
    "width": "full"
  },
  "/illustrations/remote_base_url": {
    "placeholder": "https://media.example.com/douluo",
    "width": "full"
  }
}
